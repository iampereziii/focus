# Focus — required environment variables.
# Copy to .env.local. NEVER commit .env.local.
#
# Convention #2 (project spec): a variable is documented HERE, with a description
# comment, BEFORE it is used in code.
#
# There are no OPENAI_* variables. The AI layer is CUT FROM v1 (spec Gaps 3 & 4) —
# no SDK, no lib/ai/, no API key, no model call anywhere. They return in v1.1.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Postgres + Auth (magic link, single user).
NEXT_PUBLIC_SUPABASE_URL=

# Client-safe. It is safe because RLS is ENABLED on every table with the
# predicate `auth.uid() IS NOT NULL` — not because rows are partitioned by owner.
# No table has a userId column; the app is single-user and explicitly not
# multi-tenant. See spec NFR / Gap 22.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY. Never imported into a client component — the `server-only`
# package enforces the boundary in src/lib/supabase/server.ts.
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ─────────────────────────────────────────────────────────────────────
# The origin the emailed magic link returns to — `${SITE}/auth/callback`.
# OPTIONAL. Defaults to the deployed app, https://focus-blue-psi.vercel.app,
# because the link is opened in a mail client (often on another device), where a
# localhost URL resolves to nothing. Set this only to redirect sign-in at a
# different origin — e.g. http://localhost:3000 while working on the login flow.
# Whatever you set must also be in Supabase → Authentication → URL Configuration
# → Redirect URLs, or Supabase drops it and falls back to the project Site URL.
# Enter it as a wildcard, `https://<origin>/**` — a bare origin does not match the
# `/auth/callback` path and is dropped just the same, without any error. Diagnose
# from the emailed link: `redirect_to=` carrying `/auth/callback` means the app
# chose the origin; `redirect_to=` with no path means the allow-list rejected it
# and you are looking at the dashboard's Site URL instead.
NEXT_PUBLIC_SITE_URL=

# ── Web Push ──────────────────────────────────────────────────────────────────
# Signs the two prompts the push-only service worker fires:
#   Rule 18 — the `filler` return prompt ("still waiting?")
#   Rule 26 — the check-in probe ("still on this?")
# ONE implementation serves both. A second push code path is a bug (Rule 26c).
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=

# SERVER-ONLY. Signs the push messages.
VAPID_PRIVATE_KEY=

# The mailto: or https: contact the push service is told to reach on delivery
# problems. Required by the Web Push protocol.
VAPID_SUBJECT=mailto:you@example.com

# Focus — required environment variables.
# Copy to .env.local. NEVER commit .env.local.
#
# Convention #2 (project spec): a variable is documented HERE, with a description
# comment, BEFORE it is used in code.
#
# There are no OPENAI_* variables. The AI layer is CUT FROM v1 (spec Gaps 3 & 4) —
# no SDK, no lib/ai/, no API key, no model call anywhere. They return in v1.1.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Postgres + Auth (magic link, single user).
NEXT_PUBLIC_SUPABASE_URL=

# Client-safe. It is safe because RLS is ENABLED on every table with the
# predicate `auth.uid() IS NOT NULL` — not because rows are partitioned by owner.
# No table has a userId column; the app is single-user and explicitly not
# multi-tenant. See spec NFR / Gap 22.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY. Never imported into a client component — the `server-only`
# package enforces the boundary in src/lib/supabase/server.ts.
SUPABASE_SERVICE_ROLE_KEY=

# ── Web Push ──────────────────────────────────────────────────────────────────
# Signs the two prompts the push-only service worker fires:
#   Rule 18 — the `filler` return prompt ("still waiting?")
#   Rule 26 — the check-in probe ("still on this?")
# ONE implementation serves both. A second push code path is a bug (Rule 26c).
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=

# SERVER-ONLY. Signs the push messages.
VAPID_PRIVATE_KEY=

# The mailto: or https: contact the push service is told to reach on delivery
# problems. Required by the Web Push protocol.
VAPID_SUBJECT=mailto:you@example.com
